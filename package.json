{
  "name": "unity-of-being",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:download": "node data/download.mjs",
    "data:build": "node data/build-data.mjs",
    "data:water": "node data/build-water.mjs",
    "data:civilizations": "python3 data/build-civilizations.py",
    "data:societies": "python3 data/build-societies.py",
    "data:biomes:download": "node data/download-biomes.mjs",
    "data:biomes:build": "python3 data/build-biomes.py",
    "data:maddison:download": "node data/download-maddison.mjs",
    "data:maddison:build": "python3 data/build-maddison.py",
    "data:web": "python3 data/split-web-data.py && node --max-old-space-size=6000 data/build-tiles.mjs",
    "data:polities:modern": "python3 data/build-modern-polities.py"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "geojson-vt": "^4.0.3",
    "mapshaper": "^0.7.101",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vt-pbf": "^3.1.3",
    "world-atlas": "^2.0.2"
  }
}
